{
  "name": "won-youth-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hosting": "VITE_OAUTH_ENABLED=true npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "emulators": "firebase emulators:start --project demo-won-youth-archive",
    "firebase:serve": "firebase emulators:exec --project demo-won-youth-archive --only auth,firestore,storage,functions,hosting \"npm run build\"",
    "migrate:submission-sort": "node scripts/run-submission-sort-migration.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "firebase": "12.16.0",
    "gsap": "3.15.0",
    "lucide-react": "1.25.0",
    "motion": "12.42.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-is": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "firebase-tools": "15.24.0",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5"
  }
}
